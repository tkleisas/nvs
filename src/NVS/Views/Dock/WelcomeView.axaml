<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dock="clr-namespace:NVS.ViewModels.Dock"
             mc:Ignorable="d"
             x:Class="NVS.Views.Dock.WelcomeView"
             x:DataType="dock:WelcomeDocumentViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" Spacing="24" MaxWidth="640">

            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="NVS" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="No Vim Substitute" FontSize="16" Foreground="{DynamicResource TextSecondaryForegroundBrush}" />
            </StackPanel>

            <!-- Get Started section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Get Started" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource EditorForegroundBrush}" />
                <StackPanel Spacing="4">
                    <Button Content="📂  Open Folder..."
                            Command="{Binding Main.OpenFolderCommand}"
                            Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                            Padding="4,4" HorizontalAlignment="Left"
                            FontSize="13" Cursor="Hand" />
                    <Button Content="📄  Open File..."
                            Command="{Binding Main.OpenFileCommand}"
                            Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                            Padding="4,4" HorizontalAlignment="Left"
                            FontSize="13" Cursor="Hand" />
                    <Button Content="🗂️  Open Solution..."
                            Command="{Binding Main.OpenSolutionCommand}"
                            Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                            Padding="4,4" HorizontalAlignment="Left"
                            FontSize="13" Cursor="Hand" />
                    <Button Content="✨  New File"
                            Command="{Binding Main.NewFileCommand}"
                            Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                            Padding="4,4" HorizontalAlignment="Left"
                            FontSize="13" Cursor="Hand" />
                </StackPanel>
            </StackPanel>

            <!-- Recent Workspaces -->
            <StackPanel Spacing="6" IsVisible="{Binding HasRecents}">
                <TextBlock Text="Recent" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource EditorForegroundBrush}" />
                <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.OpenRecentCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                    Padding="4,2" HorizontalAlignment="Left"
                                    FontSize="12" Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Keyboard Shortcuts Quick Reference -->
            <StackPanel Spacing="8">
                <TextBlock Text="Essential Shortcuts" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource EditorForegroundBrush}" />
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      Margin="0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+N" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="New file" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+O" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Open file" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+S" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Save" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+B" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Build solution" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="F5" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Start debugging" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="F9" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Toggle breakpoint" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Ctrl+Space" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Autocomplete" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Ctrl+`" Foreground="{DynamicResource TextForegroundBrush}" FontFamily="Consolas" FontSize="12" Padding="0,2" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Toggle terminal" Foreground="{DynamicResource TextSecondaryForegroundBrush}" FontSize="12" Padding="0,2" />
                </Grid>
            </StackPanel>

            <!-- Features -->
            <StackPanel Spacing="8">
                <TextBlock Text="Features" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource EditorForegroundBrush}" />
                <WrapPanel Orientation="Horizontal" Margin="0,4">
                    <WrapPanel.Styles>
                        <Style Selector="Border.feature">
                            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="MinWidth" Value="180"/>
                        </Style>
                    </WrapPanel.Styles>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="📝 Multi-language Editor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="Syntax highlighting, LSP, autocomplete" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🔨 Build &amp; Run" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text=".NET solutions, MSBuild integration" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🐛 Debugging" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="DAP protocol, breakpoints, variables" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🔀 Git Integration" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="Stage, commit, diff, merge conflicts" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="💬 AI Assistant" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="LLM chat, ghost-text completions, vision" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="📦 NuGet Manager" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="Search, install, update packages" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🗄 Database Explorer" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="SQLite, PostgreSQL, SQL Server, Oracle" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel Spacing="2">
                            <TextBlock Text="🌐 API Client" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                            <TextBlock Text="HTTP requests, collections, scripting" FontSize="10" Foreground="{DynamicResource TextSecondaryForegroundBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Tip -->
            <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="4" Padding="12,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="💡 Tip" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Press F1 to open the searchable Help panel with detailed guides for every feature."
                               FontSize="11" Foreground="{DynamicResource TextForegroundBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
